<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Saltwater Barrier Dam Monitoring System</title>

    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body{
            background: linear-gradient(135deg, #0f172a, #1e40af);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
        }

        .container{
            width: 90%;
            max-width: 1200px;
            text-align: center;
        }

        h1{
            font-size: 42px;
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .subtitle{
            color: #cbd5e1;
            margin-bottom: 50px;
            font-size: 18px;
        }

        .station-grid{
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .station-card{
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 40px 25px;
            backdrop-filter: blur(8px);
            transition: 0.3s;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .station-card:hover{
            transform: translateY(-10px);
            background: rgba(255,255,255,0.12);
        }

        .station-icon{
            font-size: 60px;
            margin-bottom: 20px;
        }

        .station-title{
            font-size: 28px;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .station-desc{
            color: #dbeafe;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .access-btn{
            display: inline-block;
            padding: 14px 35px;
            background: #22c55e;
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-size: 18px;
            font-weight: bold;
            transition: 0.3s;
        }

        .access-btn:hover{
            background: #16a34a;
            transform: scale(1.05);
        }

        footer{
            margin-top: 50px;
            color: #cbd5e1;
            font-size: 14px;
        }

    </style>
</head>

<body>

    <div class="container">

        <h1>SALTWATER BARRIER DAM SYSTEM</h1>

        <div class="subtitle">
            IoT2050 and Node-RED Remote Monitoring Platform
        </div>

        <div class="station-grid">

            <!-- Station 1 -->
            <div class="station-card">

                <div class="station-icon">🌊</div>

                <div class="station-title">
                    Station 1
                </div>

                <div class="station-desc">
                    Remote monitoring and control system for Saltwater Barrier Dam Station 1
                </div>

                <!-- Replace with your Ngrok link -->
                <a href="https://your-ngrok-link-1.ngrok-free.app"
                   target="_blank"
                   class="access-btn">
                    Access Station
                </a>

            </div>

            <!-- Station 2 -->
            <div class="station-card">

                <div class="station-icon">🌊</div>

                <div class="station-title">
                    Station 2
                </div>

                <div class="station-desc">
                    Remote monitoring and control system for Saltwater Barrier Dam Station 2
                </div>

                <!-- Replace with your Ngrok link -->
                <a href="https://your-ngrok-link-2.ngrok-free.app"
                   target="_blank"
                   class="access-btn">
                    Access Station
                </a>

            </div>

            <!-- Station 3 -->
            <div class="station-card">

                <div class="station-icon">🌊</div>

                <div class="station-title">
                    Station 3
                </div>

                <div class="station-desc">
                    Remote monitoring and control system for Saltwater Barrier Dam Station 3
                </div>

                <!-- Replace with your Ngrok link -->
                <a href="https://your-ngrok-link-3.ngrok-free.app"
                   target="_blank"
                   class="access-btn">
                    Access Station
                </a>

            </div>

        </div>

        <footer>
            Developed for IoT2050 SCADA Monitoring System
        </footer>

    </div>

</body>

</html>
